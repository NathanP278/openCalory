{
  "name": "opencalory",
  "version": "0.2.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "food-db:build": "npx tsx scripts/build-food-catalog.ts --tier=core",
    "food-db:build:expanded": "npx tsx scripts/build-food-catalog.ts --tier=expanded",
    "food-db:pull": "npx tsx scripts/pull-food-catalog.ts",
    "food-db:audit": "cargo run --release --manifest-path tools/catalog-dedup/Cargo.toml -- audit --input public/data/food-catalog.db.gz",
    "food-db:dedup": "cargo run --release --manifest-path tools/catalog-dedup/Cargo.toml -- compact --input public/data/food-catalog.db.gz --output-gz public/data/food-catalog.db.gz --manifest public/data/catalog-manifest.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@libsql/client": "^0.18.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}

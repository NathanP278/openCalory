# ==============================================================================
# openCalory Environment Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development or `.env` for Docker:
#   cp .env.example .env.local
#
# ALL variables below are OPTIONAL. openCalory works out of the box as an
# offline-first tracker using IndexedDB + bundled staples/PH food datasets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Food Database Search (Optional)
# ------------------------------------------------------------------------------
# Free USDA FoodData Central API key (https://fdc.nal.usda.gov/api-key-signup.html).
# If omitted, falls back to USDA's rate-limited DEMO_KEY.
USDA_API_KEY=

# ------------------------------------------------------------------------------
# 2. AI Meal Scan, Label OCR & Meal Ideas (Optional)
# ------------------------------------------------------------------------------
# Any OpenAI-compatible chat completions API with vision support
# (e.g., OpenRouter, OpenAI, Google Gemini OpenAI-compat, Ollama, vLLM).
# Example: https://openrouter.ai/api/v1  or  https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
# Vision-capable model ID (e.g., google/gemini-2.5-flash, gpt-4o-mini)
AI_MODEL=

# Optional comma-separated fallback keys and models tried in priority order
# after a fast parallel health ping when the primary fails or rate-limits.
AI_FALLBACK_API_KEYS=
AI_FALLBACK_MODELS=

# Optional JSON object of extra HTTP headers sent to the AI provider
# Example: {"HTTP-Referer":"https://your-domain.com","X-Title":"openCalory"}
AI_CUSTOM_HEADERS=

# ------------------------------------------------------------------------------
# 3. Cross-Device Cloud Sync Database (Optional)
# ------------------------------------------------------------------------------
# Supports Turso Cloud (libsql://...) or local SQLite (file:./opencalory.db).
# - On local Node.js / Docker: defaults to `file:./opencalory.db` if omitted.
# - On Vercel (serverless): set Turso credentials for persistent storage.
#   Get a free database at https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 4. Sync & AI Endpoint Access Protection (Optional, Recommended for Public Hosts)
# ------------------------------------------------------------------------------
# If set, protects `/api/db/sync` and `/api/ai/*` with a passphrase gate
# (signed HTTP-only session cookie or `Authorization: Bearer <key>`).
# Generate a strong secret: `openssl rand -hex 32`
SYNC_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 5. Apple Health iOS Shortcut Integration (Optional)
# ------------------------------------------------------------------------------
# Bearer token for `GET /api/weight/latest` so an iOS Personal Automation can
# pull today's weigh-in and log it to Apple Health.
# Generate a strong secret: `openssl rand -hex 32`
SHORTCUT_API_KEY=
